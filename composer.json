{
    "name": "siqatech/aula-virtual",
    "description": "Aula Virtual - Sistema de gestion de cursos, ediciones y matriculas para WordPress.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "phpoffice/phpspreadsheet": "^2.1"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "SIQA\\AulaVirtual\\": "includes/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs --standard=WordPress includes/ aula-virtual.php uninstall.php"
    }
}
